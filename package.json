{
    "name": "deck-oracle",
    "version": "3.3.0",
    "type": "module",
    "description": "Deck Oracle - Magic: The Gathering probability calculators",
    "main": "index.html",
    "scripts": {
        "test": "node --test tests/**/*.node.test.js",
        "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=\"js/utils/**\" --test-coverage-include=\"js/data/**\" --test-coverage-lines=84 --test-coverage-branches=84 --test-coverage-functions=83 tests/**/*.node.test.js",
        "test:perf": "node --test tests/performance/*.node.test.js",
        "test:e2e": "playwright test",
        "test:visual": "playwright test --config playwright.visual.config.js",
        "test:visual:update": "playwright test --config playwright.visual.config.js --update-snapshots=all",
        "test:watch": "node --test --watch tests/**/*.node.test.js",
        "sw:manifest": "node scripts/update-sw-manifest.mjs",
        "lint": "eslint js serverless sw.js scripts tests/**/*.node.test.js tests/e2e tests/visual playwright.config.js playwright.visual.config.js eslint.config.js",
        "check": "npm run lint && npm run test:coverage && npm run test:e2e",
        "dev": "http-server . -p 3000 -c-1"
    },
    "keywords": [
        "mtg",
        "magic",
        "calculator",
        "probability",
        "hypergeometric"
    ],
    "author": "",
    "license": "MIT",
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@playwright/test": "1.65.1",
        "chart.js": "4.6.1",
        "eslint": "10.15.0",
        "globals": "17.14.0",
        "http-server": "14.1.1",
        "lz-string": "1.5.0"
    },
    "engines": {
        "node": ">=22.12.0"
    }
}
